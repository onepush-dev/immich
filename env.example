# Immich v3.3.3 on Railway: every variable with its TEMPLATE expression.
# ${{secret(N, ...)}} values are generated per deploy; everything else is a literal or a reference.
# Nothing here needs to be filled in at deploy time.

### immich-server (public, port 2283, health /api/server/ping, volume /data)
PORT=2283
IMMICH_PORT=2283
DB_HOSTNAME=${{Postgres.RAILWAY_PRIVATE_DOMAIN}}
DB_PORT=5432
DB_USERNAME=${{Postgres.POSTGRES_USER}}
DB_PASSWORD=${{Postgres.POSTGRES_PASSWORD}}
DB_DATABASE_NAME=${{Postgres.POSTGRES_DB}}
REDIS_HOSTNAME=${{Valkey.RAILWAY_PRIVATE_DOMAIN}}
REDIS_PORT=6379
REDIS_PASSWORD=${{Valkey.REDIS_PASSWORD}}
IMMICH_MACHINE_LEARNING_URL=http://${{immich-machine-learning.RAILWAY_PRIVATE_DOMAIN}}:3003
TZ=Etc/UTC

### immich-machine-learning (private, port 3003, health /ping, volume /cache)
PORT=3003
IMMICH_HOST=[::]
IMMICH_PORT=3003
MACHINE_LEARNING_CACHE_FOLDER=/cache
MACHINE_LEARNING_WORKERS=1
MACHINE_LEARNING_MODEL_TTL=300

### Postgres (ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0, volume /var/lib/postgresql/data)
# Immich requires an alphanumeric DB password (A-Za-z0-9 only).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
POSTGRES_DB=immich
POSTGRES_INITDB_ARGS=--data-checksums
PGDATA=/var/lib/postgresql/data/pgdata
DB_STORAGE_TYPE=SSD
PGHOST=${{RAILWAY_PRIVATE_DOMAIN}}
PGPORT=5432
PGUSER=${{POSTGRES_USER}}
PGPASSWORD=${{POSTGRES_PASSWORD}}
PGDATABASE=${{POSTGRES_DB}}
DATABASE_URL=postgresql://${{POSTGRES_USER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{POSTGRES_DB}}

### Valkey (valkey/valkey:9.1.2, volume /data, start command in railway/valkey-start-command.txt)
REDIS_PASSWORD=${{secret(32, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")}}
REDISHOST=${{RAILWAY_PRIVATE_DOMAIN}}
REDISPORT=6379
REDISUSER=default
REDISPASSWORD=${{REDIS_PASSWORD}}
REDIS_URL=redis://default:${{REDIS_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:6379
